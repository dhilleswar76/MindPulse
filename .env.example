# -----------------------------------------------------------------------------
# MindPulse Environment Variables Template (SIH26094)
# -----------------------------------------------------------------------------

# Backend Service Configuration (Render / Production)
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
FRONTEND_URL=https://mindpulse.vercel.app

# Frontend Client Configuration (Vercel / Production)
# Set in frontend/.env or Vercel Environment Variables:
# VITE_API_BASE_URL=https://mindpulse-backend.onrender.com/api

# Database & Cache (MongoDB Atlas / Local)
# If MongoDB is not running locally, backend falls back gracefully to in-memory mode for zero-friction testing
MONGODB_URI=mongodb://localhost:27017/mindpulse
REDIS_URL=redis://localhost:6379

# Authentication & Security
JWT_SECRET=mindpulse_super_secure_jwt_secret_key_change_in_production_2026
JWT_EXPIRES_IN=7d

# Microservices Communication (Server-to-Server)
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_API_KEY=mindpulse_internal_ml_service_key_2026

# Non-Diagnostic AI / Support Assistant Configuration
LLM_API_KEY=mock_or_your_api_key_here
LLM_MODEL=gemini-1.5-flash

# Synthetic Demo Seeder Credentials
SEED_DEFAULT_PASSWORD=MindPulseDemo2026!

