# -----------------------------------------------------------------------------
# MindPulse Environment Variables Template
# -----------------------------------------------------------------------------

# Backend Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database & Cache
# If MongoDB is not running locally, backend falls back gracefully to in-memory mode for rapid hackathon testing
MONGODB_URI=mongodb://localhost:27017/mindpulse
REDIS_URL=redis://localhost:6379

# Authentication & Security
JWT_SECRET=mindpulse_super_secure_jwt_secret_key_change_in_production_2026
JWT_EXPIRES_IN=7d

# Microservices Communication
ML_SERVICE_URL=http://localhost:8000

# AI / Support Assistant Configuration
LLM_API_KEY=mock_or_your_api_key_here
LLM_MODEL=gemini-1.5-flash

# Seed Configuration
SEED_DEFAULT_PASSWORD=MindPulseDemo2026!
